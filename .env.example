# Silverwing-ML environment variables
# Copy to .env and fill in values as needed.
# .env is gitignored — never commit secrets.

# ---------------------------------------------------------------------------
# Corpus sources
# ---------------------------------------------------------------------------
# foundation/corpus/config.py uses CORPUS_SOURCE_<N> to override the `path`
# for the Nth source declared in configs/corpus.yaml.
# Set to the local path of your corpus data files.
CORPUS_SOURCE_0=./data/raw/my_corpus.txt
# CORPUS_SOURCE_1=./data/raw/second_corpus.txt
# CORPUS_SOURCE_2=./data/raw/third_corpus.txt

# ---------------------------------------------------------------------------
# HuggingFace integration
# ---------------------------------------------------------------------------
# Required only for ingestion scripts that download from HuggingFace Hub
# (e.g., scripts/ingest_external.py, foundation/corpus/ingestion.py).
# For public datasets the token is optional; set it for private/gated datasets.
HF_TOKEN=

# Suppress tokenizers parallelism warning (recommended: false for single-threaded)
TOKENIZERS_PARALLELISM=false

# ---------------------------------------------------------------------------
# HTTP API server (serving/api/server.py, runtime/api.py)
# ---------------------------------------------------------------------------
# Port and host for the model serving API.
SERVE_HOST=127.0.0.1
SERVE_PORT=8000
